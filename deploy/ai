#!/bin/bash

# === ПУТИ И НАСТРОЙКИ ===
WORKER_DIR="/opt/ai-worker"
VENV_PYTHON="/opt/ai-worker/venv/bin/python3"
WORKER_SCRIPT="/opt/ai-worker/Worker_v3.py"
WORKER_LOG="/opt/ai-worker/worker.log"
TMUX_SESSION="ai_worker"

LLM_MODEL="/opt/ai-worker/models/llm/Qwen3.8-27B-UD-Q3_K_XL.gguf"
COMFY_MODEL="/opt/ai-worker/models/comfy/checkpoints/animagine-xl-3.1-fp8-e4m3fn.safetensors"

LLM_CONTAINER="llama_qwen"
COMFY_CONTAINER="comfy_nova"

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

trap ':' INT

pause() {
    echo ""
    read -p "Нажмите Enter, чтобы вернуться в меню..."
}

start_worker_tmux() {
    mkdir -p "$WORKER_DIR/output"
    tmux kill-session -t "$TMUX_SESSION" 2>/dev/null
    tmux new-session -d -s "$TMUX_SESSION" "cd $WORKER_DIR && while true; do $VENV_PYTHON -u $WORKER_SCRIPT 2>&1 | tee -a $WORKER_LOG; echo '[SYSTEM] Воркер остановился, перезапуск через 5 сек...' | tee -a $WORKER_LOG; sleep 5; done"
}

while true; do
    clear
    if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
        WORKER_STATUS="${GREEN}[РАБОТАЕТ В ФОНЕ (tmux: $TMUX_SESSION)]${NC}"
    else
        WORKER_STATUS="${RED}[ОСТАНОВЛЕН]${NC}"
    fi

    echo -e "${CYAN}=====================================================${NC}"
    echo -e "${GREEN}             ПАНЕЛЬ УПРАВЛЕНИЯ AI-WORKER             ${NC}"
    echo -e " Статус воркера: ${WORKER_STATUS}"
    echo -e "${CYAN}=====================================================${NC}"
    echo -e " ${YELLOW}1)${NC} Память (free -h + Mlocked) и статус кэша моделей"
    echo -e " ${YELLOW}2)${NC} Состояние видеокарты (rocm-smi)"
    echo -e " ${YELLOW}3)${NC} Мониторинг GPU в реальном времени (watch rocm-smi)"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    echo -e " ${YELLOW}4)${NC} vmtouch: Qwen LLM (проверить / прогреть / залочить / выгрузить)"
    echo -e " ${YELLOW}5)${NC} vmtouch: Animagine ComfyUI (проверить / прогреть -vt / выгрузить)"
    echo -e " ${YELLOW}6)${NC} vmtouch: Сбросить все модели и очистить RAM (pkill + evict)"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    echo -e " ${YELLOW}7)${NC} Управление Воркером в tmux (Старт / Логи / Стоп)"
    echo -e " ${YELLOW}8)${NC} Живые логи контейнера Qwen (${LLM_CONTAINER})"
    echo -e " ${YELLOW}9)${NC} Живые логи контейнера ComfyUI (${COMFY_CONTAINER})"
    echo -e " ${YELLOW}10)${NC} Статус контейнеров Docker (и восстановление после down)"
    echo -e "${CYAN}-----------------------------------------------------${NC}"
    echo -e " ${RED}0)${NC} Выход"
    echo -e "${CYAN}=====================================================${NC}"
    read -p "Выберите пункт [0-10]: " choice

    case $choice in
        1)
            echo -e "\n${GREEN}--- Оперативная память (free -h) ---${NC}"
            free -h
            echo -e "\n${GREEN}--- Заблокировано в ядре (mlock) ---${NC}"
            grep -E "Mlocked|Unevictable" /proc/meminfo
            echo -e "\n${GREEN}--- Кэш модели Qwen LLM ---${NC}"
            vmtouch "$LLM_MODEL"
            echo -e "\n${GREEN}--- Кэш модели Animagine XL ---${NC}"
            vmtouch "$COMFY_MODEL"
            pause
            ;;
        2)
            echo -e "\n${GREEN}--- Состояние GPU (rocm-smi) ---${NC}"
            rocm-smi
            pause
            ;;
        3)
            echo -e "${YELLOW}Нажмите Ctrl+C для возврата в меню...${NC}"
            sleep 1
            watch -n 1 rocm-smi
            ;;
        4)
            echo -e "\n${CYAN}--- Управление кэшем Qwen LLM ---${NC}"
            echo "1) Проверить статус в RAM"
            echo "2) Прогреть в кэш с полосой загрузки (vmtouch -vt)"
            echo "3) Намертво заблокировать в RAM через службу (vmtouch-lock)"
            echo "4) Выгрузить из RAM (vmtouch -e)"
            read -p "Выбор [1-4]: " q_choice
            case $q_choice in
                1) vmtouch "$LLM_MODEL" ;;
                2) vmtouch -vt "$LLM_MODEL" ;;
                3)
                    if systemctl list-unit-files | grep -q "vmtouch-lock.service"; then
                        systemctl restart vmtouch-lock.service
                        systemctl status vmtouch-lock.service --no-pager
                    else
                        ulimit -l unlimited 2>/dev/null
                        vmtouch -dl "$LLM_MODEL"
                        echo "Запущен фоновый процесс vmtouch -dl."
                    fi
                    ;;
                4)
                    systemctl stop vmtouch-lock.service 2>/dev/null
                    vmtouch -e "$LLM_MODEL"
                    ;;
            esac
            pause
            ;;
        5)
            echo -e "\n${CYAN}--- Управление кэшем Animagine XL (ComfyUI) ---${NC}"
            echo -e "${RED}Внимание: флаг -l для второй модели отключен во избежание зависания 24 ГБ RAM!${NC}"
            echo "1) Проверить статус в RAM"
            echo "2) Безопасно прогреть в кэш (vmtouch -vt)"
            echo "3) Выгрузить из RAM (vmtouch -e)"
            read -p "Выбор [1-3]: " c_choice
            case $c_choice in
                1) vmtouch "$COMFY_MODEL" ;;
                2) vmtouch -vt "$COMFY_MODEL" ;;
                3) vmtouch -e "$COMFY_MODEL" ;;
            esac
            pause
            ;;
        6)
            echo -e "\n${YELLOW}Останавливаем процессы vmtouch и очищаем кэш моделей...${NC}"
            systemctl stop vmtouch-lock.service 2>/dev/null
            pkill -9 vmtouch 2>/dev/null
            vmtouch -e "$LLM_MODEL"
            vmtouch -e "$COMFY_MODEL"
            echo -e "\n${GREEN}Готово! Текущее состояние памяти:${NC}"
            free -h
            pause
            ;;
        7)
            echo -e "\n${CYAN}--- Фоновый Воркер в tmux (${TMUX_SESSION}) ---${NC}"
            echo "1) Запустить / Перезапустить воркер в фоне и открыть логи"
            echo "2) Смотреть живые логи (Ctrl+C вернет в меню, воркер НЕ остановится)"
            echo "3) Подключиться напрямую к окну tmux (свернуть обратно: Ctrl+B, затем D)"
            echo "4) Остановить фоновый воркер"
            echo "5) Очистить файл логов (worker.log)"
            read -p "Выбор [1-5]: " w_choice
            case $w_choice in
                1)
                    echo -e "${GREEN}Запускаем Worker_v3.py в фоновой сессии tmux...${NC}"
                    start_worker_tmux
                    sleep 1
                    echo -e "${YELLOW}Показываю живые логи (Нажмите Ctrl+C для выхода в меню — воркер продолжит работу в фоне):${NC}\n"
                    tail -n 50 -f "$WORKER_LOG"
                    ;;
                2)
                    if [ -f "$WORKER_LOG" ]; then
                        echo -e "${YELLOW}Живые логи (Нажмите Ctrl+C для возврата в меню):${NC}\n"
                        tail -n 50 -f "$WORKER_LOG"
                    else
                        echo -e "${RED}Лог-файл пока не создан. Сначала запустите воркер (пункт 1).${NC}"
                        pause
                    fi
                    ;;
                3)
                    if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
                        echo -e "${YELLOW}Внимание: внутри tmux НЕ нажимайте Ctrl+C, иначе остановите воркер!${NC}"
                        echo -e "${YELLOW}Чтобы свернуть окно обратно в фон, нажмите: Ctrl+B, отпустите и нажмите английскую D${NC}"
                        sleep 2
                        tmux attach-session -t "$TMUX_SESSION"
                    else
                        echo -e "${RED}Сессия tmux не запущена!${NC}"
                        pause
                    fi
                    ;;
                4)
                    tmux kill-session -t "$TMUX_SESSION" 2>/dev/null
                    echo -e "${RED}Фоновый воркер остановлен.${NC}"
                    pause
                    ;;
                5)
                    > "$WORKER_LOG"
                    echo -e "${GREEN}Файл worker.log очищен.${NC}"
                    pause
                    ;;
            esac
            ;;
        8)
            echo -e "\n${YELLOW}Логи контейнера ${LLM_CONTAINER} (Нажмите Ctrl+C для возврата в меню):${NC}\n"
            docker logs -f --tail 50 "$LLM_CONTAINER"
            pause
            ;;
        9)
            echo -e "\n${YELLOW}Логи контейнера ${COMFY_CONTAINER} (Нажмите Ctrl+C для возврата в меню):${NC}\n"
            docker logs -f --tail 50 "$COMFY_CONTAINER"
            pause
            ;;
        10)
            echo -e "\n${GREEN}--- Список контейнеров (docker ps -a) ---${NC}"
            docker ps -a
            echo ""
            read -p "Создать контейнеры заново без запуска (если пропали после down)? [y/N]: " d_choice
            if [[ "$d_choice" =~ ^[Yy]$ ]]; then
                cd "$WORKER_DIR" && docker compose up --no-start
                docker ps -a
            fi
            pause
            ;;
        0)
            clear
            exit 0
            ;;
        *)
            echo -e "${RED}Неверный выбор!${NC}"
            sleep 1
            ;;
    esac
done
EOF
