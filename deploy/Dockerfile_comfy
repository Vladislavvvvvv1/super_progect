FROM rocm/dev-ubuntu-22.04:6.2.4

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ENV CFLAGS="-march=ivybridge -mtune=ivybridge -mno-avx2 -mno-fma -mno-bmi -mno-bmi2"
ENV CXXFLAGS="-march=ivybridge -mtune=ivybridge -mno-avx2 -mno-fma -mno-bmi -mno-bmi2"
ENV NPY_DISABLE_CPU_FEATURES="AVX2,FMA3,BMI,BMI2"
ENV ATEN_CPU_CAPABILITY="avx"
ENV OPENBLAS_CORETYPE="IvyBridge"

ENV HSA_OVERRIDE_GFX_VERSION=9.0.6
ENV PYTORCH_ROCM_ARCH="gfx906"

WORKDIR /app/ComfyUI

RUN git clone --depth 1 https://github.com/Comfy-Org/ComfyUI.git .

RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/rocm6.2.4

RUN pip3 install --no-cache-dir -r requirements.txt && \
    pip3 install --no-cache-dir --force-reinstall "kornia-rs==0.1.10"

EXPOSE 8188

ENTRYPOINT ["python3", "main.py"]
